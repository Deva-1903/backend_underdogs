# ==================================
# BACKEND ENVIRONMENT VARIABLES
# ==================================
# Copy this file to .env and fill in your actual values
# DO NOT commit the .env file to version control

# ==================================
# SERVER CONFIGURATION
# ==================================
# Port on which the server will run
PORT=5000

# Environment mode (development, production, test)
NODE_ENV=development

# ==================================
# DATABASE
# ==================================
# MongoDB connection string
# Format: mongodb://username:password@host:port/database
# Or for MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/database
MONGO_URI=mongodb://localhost:27017/underdogs_fitness

# ==================================
# AUTHENTICATION
# ==================================
# Secret key for JWT token generation and verification
# Generate a strong random string (minimum 32 characters)
# You can generate one using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_key_here_minimum_32_characters

# ==================================
# EMAIL SERVICE (SendGrid)
# ==================================
# SendGrid API Key for sending emails
# Get your API key from: https://app.sendgrid.com/settings/api_keys
# IMPORTANT: Verify sender email at: https://app.sendgrid.com/settings/sender_auth
SENDGRID_API_KEY=your_sendgrid_api_key_here

# Sender email address (must be verified in SendGrid)
SENDER_EMAIL=underdogsfitnessclub@gmail.com

# ==================================
# WEBHOOK SECURITY (Optional)
# ==================================
# Secret for GitHub webhook authentication
# Set this in GitHub webhook configuration for added security
WEBHOOK_SECRET=your_webhook_secret_here
